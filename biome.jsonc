{
    "organizeImports": {
        "enabled": true
    },
    "formatter": {
        "enabled": true,
        "ignore": [
            "target/**",
            "dist/**",
            "build/**",
            "pkg/**",
            "npm/**",
            "node_modules/**",
            "packages/**/index.js",
            "public/**",
            "*.d.ts",
            ".cargo/**",
            ".github/**",
            ".vscode/**",
            ".idea/**"
        ],
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "indentStyle": "space",
            "lineWidth": 120,
            "trailingComma": "none"
        }
    },
    "linter": {
        "enabled": false
    }
}
