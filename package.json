    "dprint": "^0.45.1",
    "prettier": "^3.2.5",
    "tsx": "^4.7.2",
    "turbo": "^1.13.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.4.0",
    "wasm-pack": "^0.12.1"
  }
